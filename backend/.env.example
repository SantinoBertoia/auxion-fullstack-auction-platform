NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://auxion_user:auxion_local_password@localhost:5432/auxion_local
DATABASE_SSL=false
PG_POOL_MAX=8

JWT_SECRET=replace-this-with-a-local-jwt-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:3000,http://127.0.0.1:19006,http://127.0.0.1:8081

ALLOW_DB_RESET=true
AUTO_SEED_ON_START=false
ENABLE_REGISTRATION_REVIEW_JOB=true
AUTO_VERIFY_PAYMENT_FOR_DEMO=false

REGISTRATION_REVIEW_MINUTES=30
PASSWORD_RESET_TOKEN_MINUTES=30
MAIL_TRANSPORT=console

BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
DEMO_IMAGE_BASE_URL=
